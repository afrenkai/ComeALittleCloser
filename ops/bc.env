# Boston College Andromeda settings. Source from the project root before sbatch:
#   source ops/bc.env && sbatch ops/embed.sbatch
# Exported variables reach the job; SBATCH_* override the script directives.
bc_storage_root="/projects/weilab/${USER}/.cache"
export PATH="$HOME/.local/bin:$PATH"
export UV_CACHE_DIR="$bc_storage_root/uv"
export UV_PYTHON_INSTALL_DIR="$bc_storage_root/uv-python"
export HF_HOME="$bc_storage_root/huggingface"
export TORCH_HOME="$bc_storage_root/torch"
export SBATCH_ACCOUNT="weilab"
export SBATCH_MAIL_USER="${USER}@bc.edu"
export SBATCH_MAIL_TYPE="ALL"
# The site profile sets SBATCH_EXPORT=none; pass only the cache locations into jobs.
export SBATCH_EXPORT="HF_HOME,UV_CACHE_DIR,UV_PYTHON_INSTALL_DIR,TORCH_HOME"
# Torch cu129 wheels need sm_75+; these features select A100, L40S, and H200 nodes and skip V100.
bc_sbatch_gpu() { sbatch --constraint='vr40g|vr80g|vr144g' "$@"; }
# The gtml partition (one L40S node, one L4 node) can start sooner when short is backed up.
bc_sbatch_gtml() { sbatch --partition=gtml --account=gtml --gres=gpu:l40s:1 "$@"; }
